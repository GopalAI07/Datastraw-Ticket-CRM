# ==========================================
# Root .gitignore - Datastraw CRM
# ==========================================

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python / Backend
__pycache__/
backend/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/myvenv/
backend/venv/
backend/env/
myvenv/
venv/
env/
.pytest_cache/
.coverage

# Environment & Secrets
.env
.env.*
.env.local
.env.*.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!**/.env.example
*.pem
*.key

# IDEs & System Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
